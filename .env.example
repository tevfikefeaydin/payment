# =============================================================================
# PayRecon environment configuration
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# Every variable below is validated at startup by @payrecon/config. Startup
# reports the NAME of any missing/invalid variable and never prints its VALUE.
# =============================================================================

# --- Core -------------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development

# Absolute, externally reachable base URL of the web app. Used to build links in
# emails and Slack messages, and to set secure cookie/CSRF origin expectations.
APP_URL=http://localhost:3000

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info


# --- Database ---------------------------------------------------------------
# PostgreSQL connection string for the system of record.
# The local dev cluster created by `scripts/setup-local.ps1` listens on 55432.
DATABASE_URL=postgresql://postgres:payrecon_dev_pw@127.0.0.1:55432/payrecon_dev

# Separate database used by the integration test suite. It is TRUNCATED between
# test files, so it must never point at a database holding real data.
TEST_DATABASE_URL=postgresql://postgres:payrecon_dev_pw@127.0.0.1:55432/payrecon_test


# --- Authentication ---------------------------------------------------------
# Secret used to derive CSRF tokens and sign short-lived auth artefacts.
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-32-random-bytes-base64-encoded

# Session lifetime in seconds (default 30 days) and idle timeout in seconds.
SESSION_MAX_AGE_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=604800


# --- Credential encryption (AES-256-GCM) ------------------------------------
# Master key for encrypting customer Stripe restricted keys and Slack webhook
# URLs at rest. MUST be exactly 32 bytes, base64-encoded (44 chars ending "=").
# Generate with: openssl rand -base64 32
# Losing this key makes every stored credential permanently unreadable.
ENCRYPTION_KEY=replace-me-with-exactly-32-random-bytes-base64=

# Identifier for the active encryption key, recorded alongside every ciphertext
# so that keys can be rotated without ambiguity. Bump when rotating.
ENCRYPTION_KEY_ID=k1

# Optional: previous key retained ONLY to decrypt values not yet re-encrypted.
# Leave blank unless a rotation is in progress.
ENCRYPTION_KEY_PREVIOUS=
ENCRYPTION_KEY_PREVIOUS_ID=


# --- Customer Stripe data integration (READ-ONLY) ---------------------------
# PayRecon never stores a customer's Stripe key here; customers supply their own
# restricted key through the UI and it is encrypted at rest immediately.
# This flag selects the transport used to read customer Stripe data:
#   live => real Stripe API over HTTPS (restricted keys only)
#   fake => deterministic in-repo adapter used by tests and the demo
STRIPE_CUSTOMER_TRANSPORT=live

# Requests per second ceiling applied to customer Stripe reads, per connection.
STRIPE_CUSTOMER_RATE_LIMIT_RPS=8


# --- Platform billing (PayRecon's OWN Stripe account) -----------------------
# COMPLETELY SEPARATE from the customer data integration above. These credentials
# must never be used to read a customer's operational data, and a customer's
# restricted key must never be passed to platform billing code.
# Leave blank to run with billing disabled (the UI shows an unconfigured state).
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_WEBHOOK_SECRET=
PLATFORM_STRIPE_PRICE_STARTER=
PLATFORM_STRIPE_PRICE_GROWTH=
PLATFORM_STRIPE_PRICE_SCALE=


# --- Email notifications ----------------------------------------------------
# SMTP transport for exception digests and verification messages.
# Leave SMTP_HOST blank to use the console transport (development only).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="PayRecon <notifications@payrecon.local>"


# --- Worker -----------------------------------------------------------------
# Number of jobs a single worker process handles concurrently.
WORKER_CONCURRENCY=4

# Port for the worker's liveness (/health/live) and readiness (/health/ready)
# endpoints. The web app's own probe lives at /health on its normal port.
WORKER_HEALTH_PORT=3001

# How often (cron) recurring reconciliation runs are scheduled for each org.
RECONCILIATION_SCHEDULE_CRON=0 * * * *
