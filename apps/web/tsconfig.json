{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["node", "react", "react-dom"],
    "allowJs": true,
    "moduleDetection": "force",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@payrecon/config": ["../../packages/config/src/index.ts"],
      "@payrecon/config/*": ["../../packages/config/src/*"],
      "@payrecon/db": ["../../packages/db/src/index.ts"],
      "@payrecon/db/*": ["../../packages/db/src/*"],
      "@payrecon/domain": ["../../packages/domain/src/index.ts"],
      "@payrecon/domain/*": ["../../packages/domain/src/*"],
      "@payrecon/auth": ["../../packages/auth/src/index.ts"],
      "@payrecon/auth/*": ["../../packages/auth/src/*"],
      "@payrecon/jobs": ["../../packages/jobs/src/index.ts"],
      "@payrecon/jobs/*": ["../../packages/jobs/src/*"],
      "@payrecon/notifications": ["../../packages/notifications/src/index.ts"],
      "@payrecon/notifications/*": ["../../packages/notifications/src/*"],
      "@payrecon/ingestion": ["../../packages/ingestion/src/index.ts"],
      "@payrecon/ingestion/*": ["../../packages/ingestion/src/*"],
      "@payrecon/stripe-customer-data": ["../../packages/stripe-customer-data/src/index.ts"],
      "@payrecon/stripe-customer-data/*": ["../../packages/stripe-customer-data/src/*"],
      "@payrecon/platform-billing": ["../../packages/platform-billing/src/index.ts"],
      "@payrecon/platform-billing/*": ["../../packages/platform-billing/src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "**/*.test.ts"]
}
